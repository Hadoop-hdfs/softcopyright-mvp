# 指定启动时要加载的 env 文件路径；仅通过系统环境变量设置时生效，写在 .env 内不会改变本次加载路径。
SOFTCOPYRIGHT_ENV_FILE=.env

# 配置 AI 服务的 Chat Completions 接口地址。
SOFTCOPYRIGHT_AI_API_URL=https://inference-api.nousresearch.com/v1/chat/completions

# 配置 AI 服务的 API key；留空时会从本地 auth.json 读取。
SOFTCOPYRIGHT_AI_API_KEY=

# 配置本地认证文件路径，用于在未设置 API key 时读取密钥。
SOFTCOPYRIGHT_AUTH_PATH=~/.hermes/auth.json

# 配置本地认证文件中的 provider 名称。
SOFTCOPYRIGHT_AUTH_PROVIDER=nous

# 配置默认 AI 模型名称。
SOFTCOPYRIGHT_AI_MODEL=xiaomi/mimo-v2-pro

# 配置单次 AI 请求的最大输出 token 数。
SOFTCOPYRIGHT_AI_MAX_TOKENS=8192

# 配置 AI 请求 temperature，数值越高输出越发散。
SOFTCOPYRIGHT_AI_TEMPERATURE=0.7

# 配置 AI 请求超时时间，单位为秒。
SOFTCOPYRIGHT_AI_TIMEOUT_SECONDS=300

# 配置 AI JSON 解析失败时打印的原始输出预览长度。
SOFTCOPYRIGHT_AI_JSON_ERROR_PREVIEW_CHARS=500

# 配置项目实例输出目录。
SOFTCOPYRIGHT_PROJECTS_DIR=projects

# 配置 P1/P2/P3 prompt 文件目录。
SOFTCOPYRIGHT_PROMPTS_DIR=prompts

# 配置可选模板目录，优先查找其中的 dashboard.html。
SOFTCOPYRIGHT_TEMPLATES_DIR=templates

# 配置默认截图 HTML 模板路径。
SOFTCOPYRIGHT_DEFAULT_TEMPLATE_PATH=template.html

# 配置默认 MVP mock 数据路径。
SOFTCOPYRIGHT_DEFAULT_DATA_PATH=data.json

# 配置项目目录安全名称的最大长度。
SOFTCOPYRIGHT_PROJECT_SAFE_NAME_MAX_LENGTH=50

# 配置 P2 架构阶段允许的最小文件数量。
SOFTCOPYRIGHT_P2_MIN_FILE_COUNT=15

# 配置 P2 架构阶段允许的最大文件数量。
SOFTCOPYRIGHT_P2_MAX_FILE_COUNT=25

# 配置 P2 架构阶段要求的最小总行数。
SOFTCOPYRIGHT_P2_MIN_TOTAL_LINES=2500

# 配置 P3 前哨站审批前生成的文件数量。
SOFTCOPYRIGHT_P3_CHECKPOINT_COUNT=3

# 配置 P3 单文件代码生成最大重试次数。
SOFTCOPYRIGHT_P3_MAX_RETRIES=3

# 配置 P3 主流程中依赖文件摘要截取长度。
SOFTCOPYRIGHT_P3_RELATED_SUMMARY_CHARS=500

# 配置渲染子进程超时时间，单位为秒。
SOFTCOPYRIGHT_RENDER_TIMEOUT_SECONDS=120

# 配置打包子进程超时时间，单位为秒。
SOFTCOPYRIGHT_PACK_TIMEOUT_SECONDS=120

# 配置默认截图输出目录。
SOFTCOPYRIGHT_RENDER_OUTPUT_DIR=render_outputs

# 配置模板使用的 Tailwind CDN 地址。
SOFTCOPYRIGHT_TAILWIND_CDN_URL=https://cdn.tailwindcss.com

# 配置默认主题色。
SOFTCOPYRIGHT_THEME_COLOR=#1E40AF

# 配置 Playwright 截图 viewport 宽度。
SOFTCOPYRIGHT_VIEWPORT_WIDTH=1280

# 配置 Playwright 截图 viewport 高度。
SOFTCOPYRIGHT_VIEWPORT_HEIGHT=800

# 配置 Playwright 是否使用 headless 模式。
SOFTCOPYRIGHT_PLAYWRIGHT_HEADLESS=true

# 配置页面渲染完成后的等待时间，单位为毫秒。
SOFTCOPYRIGHT_RENDER_WAIT_MS=1000

# 配置 MVP 菜单点击操作的超时时间，单位为毫秒。
SOFTCOPYRIGHT_MENU_CLICK_TIMEOUT_MS=3000

# 配置菜单点击后的等待时间，单位为毫秒。
SOFTCOPYRIGHT_SUBMENU_WAIT_MS=500

# 配置中文字体回退列表，多个字体用英文逗号分隔。
SOFTCOPYRIGHT_CJK_FONT_FAMILY=Noto Sans CJK SC,WenQuanYi Micro Hei,Microsoft YaHei,PingFang SC

# 配置 MVP 截图脚本点击的菜单文本。
SOFTCOPYRIGHT_MVP_CLICK_MENU_TEXT=能耗分析

# 配置模板侧边栏底部显示的版本文案。
SOFTCOPYRIGHT_TEMPLATE_VERSION_TEXT=版本 v2.4.1 · 企业版

# 配置模板顶栏显示的管理员名称。
SOFTCOPYRIGHT_TEMPLATE_ADMIN_NAME=Admin

# 配置模板表格区域显示的刷新频率文案。
SOFTCOPYRIGHT_TEMPLATE_REFRESH_TEXT=自动刷新：30s

# 配置模板底部显示的数据源文案。
SOFTCOPYRIGHT_TEMPLATE_DATA_SOURCE_TEXT=数据源：Modbus-TCP / OPC-UA 双通道

# 配置 Word 文档正文字体。
SOFTCOPYRIGHT_DOC_BODY_FONT=仿宋_GB2312

# 配置 Word 文档页眉页脚字体。
SOFTCOPYRIGHT_DOC_HEADER_FONT=宋体

# 配置 Word 文档标题字体。
SOFTCOPYRIGHT_DOC_TITLE_FONT=黑体

# 配置源代码文档中的代码字体。
SOFTCOPYRIGHT_DOC_CODE_FONT=Courier New

# 配置软件设计说明书正文字号。
SOFTCOPYRIGHT_DOC_BODY_FONT_SIZE=12

# 配置源代码文档正文字号。
SOFTCOPYRIGHT_DOC_SOURCE_BODY_FONT_SIZE=10.5

# 配置软件设计说明书标题字号。
SOFTCOPYRIGHT_DOC_TITLE_FONT_SIZE=18

# 配置源代码文档标题字号。
SOFTCOPYRIGHT_DOC_SOURCE_TITLE_FONT_SIZE=16

# 配置源代码文档代码字号。
SOFTCOPYRIGHT_DOC_CODE_FONT_SIZE=9

# 配置 Word 文档页眉字号。
SOFTCOPYRIGHT_DOC_HEADER_FONT_SIZE=10

# 配置 Word 文档页脚字号。
SOFTCOPYRIGHT_DOC_FOOTER_FONT_SIZE=9

# 配置源代码文档每页约展示的代码行数。
SOFTCOPYRIGHT_SOURCE_LINES_PER_PAGE=50

# 配置源代码文档前半部分截取页数。
SOFTCOPYRIGHT_SOURCE_FRONT_PAGES=30

# 配置源代码文档后半部分截取页数。
SOFTCOPYRIGHT_SOURCE_BACK_PAGES=30

# 配置软件设计说明书中截图插入宽度，单位为厘米。
SOFTCOPYRIGHT_SCREENSHOT_WIDTH_CM=14

# 配置 AST 相似度进入结果列表的告警阈值。
SOFTCOPYRIGHT_SIMILARITY_WARN_THRESHOLD=0.3

# 配置 AST 相似度判定校验失败的阈值。
SOFTCOPYRIGHT_SIMILARITY_FAIL_THRESHOLD=0.4

# 配置补生成脚本的目标项目目录；也可以通过命令行参数传入。
SOFTCOPYRIGHT_TARGET_PROJECT_DIR=

# 配置补生成脚本中依赖文件摘要截取长度。
SOFTCOPYRIGHT_GENERATE_REMAINING_RELATED_CHARS=400
